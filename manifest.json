{
  "manifest_version": 3,
  "name": "Gemini Live Browser Agent",
  "version": "1.1.0",
  "description": "Talk to your browser. A voice-controlled agent powered by the Gemini Live API that can manage tabs, search, fill forms, click and take screenshots.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "bookmarks",
    "downloads",
    "history",
    "tabGroups",
    "notifications",
    "clipboardRead",
    "clipboardWrite",
    "sessions",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Gemini browser agent"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
